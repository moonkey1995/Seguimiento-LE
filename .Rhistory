# ── 1. Renderizar el .Rmd ──────────────────────────────────────────────────────
rmarkdown::render("index.Rmd")
print("¡Reporte generado exitosamente!")
# ── 2. Git via system() — evita el bug de rutas largas de gert/libgit2 ─────────
repo <- "C:/Seguimiento-LE"
run_git <- function(args) {
cmd <- paste0('git -C "', repo, '" ', args)
result <- system(cmd, intern = TRUE, ignore.stderr = FALSE)
cat(result, sep = "\n")
}
print("Iniciando proceso de Git...")
print("Actualizando repositorio local ('git pull')...")
run_git("pull --rebase")
setwd("C:/Seguimiento-LE")
# ── 1. Renderizar el .Rmd ──────────────────────────────────────────────────────
rmarkdown::render("index.Rmd")
print("¡Reporte generado exitosamente!")
# ── 2. Git via system() ────────────────────────────────────────────────────────
repo <- "C:/Seguimiento-LE"
run_git <- function(args) {
cmd <- paste0('git -C "', repo, '" ', args)
result <- system(cmd, intern = TRUE, ignore.stderr = FALSE)
cat(result, sep = "\n")
}
print("Iniciando proceso de Git...")
# Guardar cambios locales temporalmente antes del pull
print("Guardando cambios locales temporalmente ('git stash')...")
run_git("stash")
setwd("C:/Seguimiento-LE")
# ── 1. Renderizar el .Rmd ──────────────────────────────────────────────────────
rmarkdown::render("index.Rmd")
print("¡Reporte generado exitosamente!")
# ── 2. Git via system() ────────────────────────────────────────────────────────
repo <- "C:/Seguimiento-LE"
run_git <- function(args) {
cmd <- paste0('git -C "', repo, '" ', args)
result <- system(cmd, intern = TRUE, ignore.stderr = FALSE)
cat(result, sep = "\n")
}
print("Iniciando proceso de Git...")
# Guardar cambios locales temporalmente antes del pull
print("Guardando cambios locales temporalmente ('git stash')...")
run_git("stash")
print("Actualizando repositorio local ('git pull')...")
run_git("pull origin main")       # Cámbia 'main' por 'master' si es tu rama
# Recuperar los cambios guardados
print("Recuperando cambios locales ('git stash pop')...")
run_git("stash pop")
print("Añadiendo archivos modificados ('git add')...")
run_git("add index.html")
# Verificar si hay algo para commitear
status <- system(
paste0('git -C "', repo, '" status --porcelain'),
intern = TRUE
)
if (length(status) > 0) {
commit_message <- paste("Reporte actualizado automaticamente el", Sys.Date())
print(paste("Haciendo commit:", commit_message))
run_git(paste0('commit -m "', commit_message, '"'))
print("Subiendo los cambios al remoto ('git push')...")
run_git("push origin main")     # Cámbia 'main' por 'master' si es tu rama
print("¡Proceso de Git finalizado exitosamente!")
} else {
print("No hay cambios nuevos para commitear. Nada que subir.")
}
