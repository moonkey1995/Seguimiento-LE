data
Data<-data %>% mutate(Horas=as.numeric(substr(`Time (sec)`,1,2)),Minutos=as.numeric(substr(`Time (sec)`,4,5)),
Minutos_n=ifelse(Minutos%%6==0,Minutos,Minutos+(10-Minutos%%10)))
