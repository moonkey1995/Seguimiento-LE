# La Función
Serie <- function(franja){
#franja = "16:30"
## filtro diario
filtro <- Final %>%
filter(Inicio == franja) %>%
# 1. Agrupamos por Fecha e Inicio para detectar días con múltiples programas
group_by(Date, Inicio) %>%
summarise(
`Description` = paste(unique(`Description`), collapse = " / "), # Concatena los nombres
`rat#` = mean(`rat#`, na.rm = TRUE),                            # Promedia el rating
.groups = "drop"
) %>%
# 2. Aseguramos el orden cronológico estricto
arrange(Date) %>%
# 3. Calculamos la variación usando la función lag() que es más segura
mutate(
rat_prev = lag(`rat#`),
variación = (`rat#` / rat_prev - 1) * 100
)
## filtro promedios
filtro2<-Franjas %>% filter(Inicio==franja)
S9<-filtro2 %>% filter(Date>=S1_L,Date<=S1_U) %>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S9")
S10<-filtro2 %>% filter(Date>=S2_L,Date<=S2_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S10")
S11<-filtro2 %>% filter(Date>=S3_L,Date<=S3_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S11")
S12<-filtro2 %>% filter(Date>=S4_L,Date<=S4_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S12")
M4<-filtro2 %>% filter(Date>=M1_L,Date<=M1_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M4")
M5<-filtro2 %>% filter(Date>=M2_L,Date<=M2_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M5")
M6<-filtro2 %>% filter(Date>=M3_L,Date<=M3_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M6")
S1<-filtro2 %>% filter(Date>=lastyear,Date<=Sem)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="Semestre")
Promedios<-rbind(S1,M6,M5,M4,S12,S11,S10,S9)
###unir bases
Diario<-filtro %>% select(Date,`Description`,`rat#`,Inicio,rat_prev,`variación`) %>% arrange(Date) %>%  mutate(Date=as.character.Date(Date))
Promedios_F<-Promedios %>% mutate(`Description`="Promedio",`rat#`=Rat_miles,rat_prev=NA,`variación`=NA)%>% select(Date,`Description`,`rat#`,Inicio,rat_prev,`variación`)
ind<-which(abs(Diario$variación)>10)
dias<-Diario[ind,]%>% arrange(by=desc(abs(`variación`)),) %>% mutate(`rat#`=round(`rat#`,0),rat_prev=round(rat_prev,0),`variación`=`variación`%>% round(1))
FINAL<-rbind(Promedios_F,Diario) %>% mutate(Date=factor(Date,levels=c(unique(Promedios_F$Date[-1]),unique(Diario$Date))))
unique(FINAL$Date)
levels(FINAL$Date)
## la gráfica
P<-plot_ly(FINAL[-1,],x=~Date,y=~`rat#`, color=~`Description`,colores=c('forestgreen','orangered',"darkmagenta") , type = 'scatter',mode="lines-markers",hoverinfo = 'text',
text = ~paste('</br> Programa ', `Description`,
'</br> Fecha ', Date,
'</br> Rat miles: ', round(`rat#`,0),
'</br> Variación: ', round(`variación`,1),"%"))%>% add_trace(y=~`rat#`,  mode = 'markers',symbols="square",color~ `Description`) %>%
layout(title = paste(filtro$`Description`[nrow(filtro)]),
xaxis = list(title = 'Fecha'),
yaxis = list(title = 'Rating miles'),annotations = list(
list(x = 0.17, y = 1, text = paste("(-) Semestre: ",round(FINAL[1,3],0)), showarrow = FALSE, xref='paper', yref='paper'))
)%>% hide_legend()
Diario<-Diario %>% mutate(Type=ifelse(`variación`>0,"Positiva","Negativa"))
v<-Diario %>% ggplot(aes(x = Date, y = `variación`)) +
geom_segment(aes(x = Date, xend = Date, y = 0, yend = `variación`, col = Type)) +
geom_point(size = 1, pch = 21,bg="black")+scale_color_manual(values=c("red","forestgreen"))+theme_minimal()+theme(axis.text.x = element_text(angle = 270))+geom_text_repel(label=Diario$`variación`)+geom_hline(aes(yintercept=10),linetype="dashed",lwd=0.5,col="gray")+geom_hline(aes(yintercept=-10),linetype="dashed",lwd=0.5,col="gray")+geom_hline(aes(yintercept=20),linetype="dotted",lwd=0.5,col="gray")+geom_hline(aes(yintercept=-20),linetype="dotted",lwd=0.5,col="gray")+geom_hline(aes(yintercept=30),linetype="longdash",lwd=0.5,col="gray")+geom_hline(aes(yintercept=-30),linetype="longdash",lwd=0.5,col="gray")
V<-ggplotly(v)%>%
layout(title = paste("Variaciones de",Diario$`Description`[nrow(Diario)]),
xaxis = list(title = 'Fecha'),
yaxis = list(title = 'Variación'))%>% hide_legend()
return(list(P,V,FINAL,dias))
}
SerieGrid<-function(franja){
##franja<-"22:30"
## filtro diario
filtro <- Final %>%
filter(Inicio == franja) %>%
# 1. Agrupamos por Fecha e Inicio para detectar días con múltiples programas
group_by(Date, Inicio) %>%
summarise(
`Description` = paste(unique(`Description`), collapse = " / "), # Concatena los nombres
`rat#` = mean(`rat#`, na.rm = TRUE),                            # Promedia el rating
.groups = "drop"
) %>%
# 2. Aseguramos el orden cronológico estricto
arrange(Date) %>%
# 3. Calculamos la variación usando la función lag() que es más segura
mutate(
rat_prev = lag(`rat#`),
variación = (`rat#` / rat_prev - 1) * 100
)
## filtro promedios
filtro2<-Franjas %>% filter(Inicio==franja)
S9<-filtro2 %>% filter(Date>=S1_L,Date<=S1_U) %>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S9")
S10<-filtro2 %>% filter(Date>=S2_L,Date<=S2_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S10")
S11<-filtro2 %>% filter(Date>=S3_L,Date<=S3_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S11")
S12<-filtro2 %>% filter(Date>=S4_L,Date<=S4_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="S12")
M4<-filtro2 %>% filter(Date>=M1_L,Date<=M1_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M4")
M5<-filtro2 %>% filter(Date>=M2_L,Date<=M2_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M5")
M6<-filtro2 %>% filter(Date>=M3_L,Date<=M3_U)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="M6")
S1<-filtro2 %>% filter(Date>=lastyear,Date<=Sem)%>% group_by(Inicio) %>%
summarise(Rat_miles=mean(`rat#`)) %>% mutate(Date="Semestre")
Promedios<-rbind(S1,M6,M5,M4,S12,S11,S10,S9)
###unir bases
Diario<-filtro %>% select(Date,`Description`,`rat#`,Inicio,rat_prev,`variación`) %>% arrange(Date) %>%  mutate(Date=as.character.Date(Date))
Promedios_F<-Promedios %>% mutate(`Description`="Promedio",`rat#`=Rat_miles,rat_prev=NA,`variación`=NA)%>% select(Date,`Description`,`rat#`,Inicio,rat_prev,`variación`)
FINAL<-rbind(Promedios_F,Diario) %>% mutate(Date=factor(Date,levels=c(unique(Promedios_F$Date[-1]),unique(Diario$Date))))
unique(FINAL$Date)
levels(FINAL$Date)
## la gráfica
P<-plot_ly(FINAL[-1,],x=~Date,y=~`rat#`, color=~`Description`,colores=c('forestgreen','orangered',"darkmagenta") , type = 'scatter',mode="lines-markers",hoverinfo = 'text',
text = ~paste('</br> Programa ', `Description`,
'</br> Fecha ', Date,
'</br> Rat miles: ', round(`rat#`,0),
'</br> Variación: ', round(`variación`,1),"%"))%>% add_trace(y=~`rat#`,  mode = 'markers',symbols="square",color~ `Description`) %>%
layout(title = list(text=paste(filtro$`Description`[nrow(filtro)])),
xaxis = list(title = 'Fecha' ),
yaxis = list(title = 'Rating miles')
)%>% hide_legend()
return(list(P,FINAL))
}
f7<-Serie("07:00")
f7[[1]]
