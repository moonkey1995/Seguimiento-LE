S4_L<-S4_U-6
M1_U<-S4_L-1
M1_L<-M1_U-29
M2_U<-M1_L-1
M2_L<-M2_U-29
M3_U<-M2_L-1
M3_L<-M3_U-29
Sem<-M3_L-1
lastyear<-Sem-180
